# Private VM120 GPU coordinator. Copy to .env.gpu and keep it uncommitted.
DIARIZATION_IMAGE=ghcr.io/antoroute/obsidian-local-ai-platform-diarization-service:main
DIARIZATION_SERVICE_TOKEN=replace-with-the-same-long-random-token-as-the-worker
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
GPU_OLLAMA_BASE_URL=http://127.0.0.1:11435
MAX_AUDIO_UPLOAD_MB=250

# Read-only Hugging Face token. Accept the pyannote model terms before first use.
HF_TOKEN=
HF_HUB_OFFLINE=0
