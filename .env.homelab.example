# Portainer stack environment for infra/docker-compose.homelab.yml.
# Copy values into Portainer; do not commit the real environment file.

GATEWAY_IMAGE=ghcr.io/antoroute/obsidian-local-ai-platform-ai-gateway:main
WHISPER_WORKER_IMAGE=ghcr.io/antoroute/obsidian-local-ai-platform-whisper-worker:main

GATEWAY_BIND_ADDRESS=10.0.20.20
GATEWAY_BIND_PORT=18000

POSTGRES_DB=obsidian_ai
POSTGRES_USER=obsidian_ai
# Use a long URL-safe value because it is interpolated into the SQLAlchemy URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

OLLAMA_BASE_URL=http://10.0.70.10:11434
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_CONCURRENT_REQUESTS=1
DEFAULT_MODEL=qwen3:8b
ALLOWED_MODELS=qwen3:8b
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_EMBEDDING_DIMENSION=1024

CORS_ALLOW_ORIGINS=app://obsidian.md,capacitor://localhost,http://localhost
MAX_AUDIO_UPLOAD_MB=250
JOB_STALLED_AFTER_SECONDS=900
JOB_HISTORY_LIMIT=50
# Independent secret used only by Prometheus for GET /metrics.
METRICS_TOKEN=replace-with-a-different-long-random-token
# Shared only between the LXC worker and the private GPU coordinator.
DIARIZATION_SERVICE_URL=http://10.0.70.10:11434
DIARIZATION_SERVICE_TOKEN=replace-with-another-long-random-token
DIARIZATION_TIMEOUT_SECONDS=1800

WHISPER_MODEL_SIZE=small
WHISPER_BEAM_SIZE=3
WHISPER_CPU_THREADS=2

MEETING_DEEP_THINK_MAX_SECTIONS=6
MEETING_DEEP_THINK_EXCERPT_CHARS_PER_SECTION=2000
MEETING_PREDIGEST_CHUNK_CHARS=24000
MEETING_PREDIGEST_MAX_CHUNKS=10
MEETING_PREDIGEST_MANUAL_NOTES_MAX_CHARS=6000
RAG_MAX_CHUNKS_PER_DOCUMENT=2
