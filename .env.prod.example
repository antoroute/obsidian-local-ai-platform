# Production-like GPU example for Docker Ollama + faster-whisper CUDA.
# Copy to .env only on the target host, then adjust secrets and hostnames locally.

COMPOSE_PROJECT_NAME=obsidian-local-ai-platform
PUBLIC_BASE_HOST=localhost
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_BIND_PORT=8000
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

AI_GATEWAY_HOST=0.0.0.0
AI_GATEWAY_PORT=8000
AI_GATEWAY_LOG_LEVEL=info
AI_GATEWAY_REQUEST_MAX_BYTES=10485760
AI_GATEWAY_DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/obsidian_ai
AI_GATEWAY_REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=ollama
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=false
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=qwen2.5:7b
ALLOWED_MODELS=qwen2.5:7b,mistral:latest,qwen2.5:14b,llama3:latest
# Minimal Ollama Docker model set:
# - qwen2.5:7b for default LLM generation on 8 GB GPUs
# - mistral:latest as a fallback/general LLM
# - nomic-embed-text:latest for RAG embeddings
# Prepare them selectively with scripts/prod/prepare-ollama-models.ps1.
OLLAMA_TIMEOUT_SECONDS=300
MAX_NOTE_CHARS=200000
MAX_TEMPLATE_CHARS=50000
MAX_TRANSCRIPT_CHARS=300000
MAX_MANUAL_NOTES_CHARS=100000
MAX_PARTICIPANTS=100
# Meeting generation is optimized for local GPUs: one LLM call by default,
# with a compact pre-digest only for long/noisy transcripts.
MEETING_TRANSCRIPT_CLEANUP_ENABLED=true
MEETING_PREDIGEST_ENABLED=true
MEETING_PREDIGEST_MIN_CHARS=12000
MEETING_DEEP_THINK_ENABLED=true
MEETING_DEEP_THINK_MAX_SECTIONS=10
MEETING_DEEP_THINK_EXCERPT_CHARS_PER_SECTION=3000
MEETING_DEEP_THINK_FINAL_CLEANUP=true
MAX_ASSISTANT_MESSAGE_CHARS=20000
MAX_ASSISTANT_CONTEXT_CHARS=100000
AUDIO_STORAGE_DIR=/data/audio
MAX_AUDIO_UPLOAD_MB=500
AUDIO_QUEUE_NAME=audio_transcription_jobs
RAG_ENABLED=true
RAG_VECTOR_BACKEND=pgvector
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_EMBEDDING_DIMENSION=768
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MAX_CHUNKS_PER_QUERY=8
RAG_MAX_CONTEXT_CHARS=24000
RAG_SEARCH_CANDIDATES=30
RAG_MIN_SCORE=0.15
RAG_KEYWORD_BONUS_ENABLED=true
RAG_KEYWORD_BONUS_MAX=0.20
RAG_INDEX_EXCLUDED_DIRS=.obsidian,Templates,Archives,Private
RAG_INDEX_EXCLUDED_TAGS=noai,private
RAG_DEFAULT_VAULT_ID=default
RAG_WORKSPACE_ID=default

POSTGRES_DB=obsidian_ai
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

REDIS_PORT=6379

WHISPER_WORKER_LOG_LEVEL=info
WHISPER_WORKER_DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/obsidian_ai
WHISPER_WORKER_REDIS_URL=redis://redis:6379/0
WHISPER_WORKER_QUEUE=audio_transcription_jobs
TRANSCRIPTION_ENGINE=faster_whisper
WHISPER_MODEL_SIZE=medium
# Prepare this faster-whisper model in the whisper-model-cache volume before real transcription.
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=5
WHISPER_MODEL_CACHE_DIR=/models/whisper
HF_HOME=/models/whisper
HUGGINGFACE_HUB_CACHE=/models/whisper/hub

# Optional local speaker diarization. Keep disabled unless the pyannote model has
# been prepared in the diarization-model-cache volume.
DIARIZATION_ENABLED=false
INSTALL_DIARIZATION=false
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cuda
DIARIZATION_MODEL_CACHE_DIR=/models/diarization
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=
