# Global
COMPOSE_PROJECT_NAME=obsidian-local-ai-platform

# AI Gateway
AI_GATEWAY_HOST=0.0.0.0
AI_GATEWAY_PORT=8000
AI_GATEWAY_LOG_LEVEL=info
AI_GATEWAY_REQUEST_MAX_BYTES=10485760
AI_GATEWAY_DATABASE_URL=sqlite:///./apps/ai-gateway/ai_gateway.db
AI_GATEWAY_REDIS_URL=redis://redis:6379/0
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=qwen2.5:14b
ALLOWED_MODELS=qwen2.5:14b,mistral:7b
OLLAMA_TIMEOUT_SECONDS=120
MAX_NOTE_CHARS=200000
MAX_TEMPLATE_CHARS=50000

# PostgreSQL
POSTGRES_DB=obsidian_ai
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PORT=6379

# Worker
WHISPER_WORKER_LOG_LEVEL=info
WHISPER_WORKER_REDIS_URL=redis://redis:6379/0
WHISPER_WORKER_QUEUE=transcription_jobs

# Obsidian plugin example settings
OBSIDIAN_PLUGIN_API_URL=http://127.0.0.1:8000
