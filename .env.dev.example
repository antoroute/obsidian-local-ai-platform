# Development/fake example for UX validation only.
# Do not use this for production-like validation.

COMPOSE_PROJECT_NAME=obsidian-local-ai-platform
PUBLIC_BASE_HOST=localhost
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

AI_GATEWAY_HOST=0.0.0.0
AI_GATEWAY_PORT=8000
AI_GATEWAY_LOG_LEVEL=debug
AI_GATEWAY_REQUEST_MAX_BYTES=10485760
AI_GATEWAY_DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/obsidian_ai
AI_GATEWAY_REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=fake
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=false
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=fake-local-model
ALLOWED_MODELS=fake-local-model,mistral:latest,qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=120
MAX_NOTE_CHARS=200000
MAX_TEMPLATE_CHARS=50000
MAX_TRANSCRIPT_CHARS=300000
MAX_MANUAL_NOTES_CHARS=100000
MAX_PARTICIPANTS=100
MAX_ASSISTANT_MESSAGE_CHARS=20000
MAX_ASSISTANT_CONTEXT_CHARS=100000
AUDIO_STORAGE_DIR=/data/audio
MAX_AUDIO_UPLOAD_MB=500
AUDIO_QUEUE_NAME=audio_transcription_jobs

POSTGRES_DB=obsidian_ai
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

REDIS_PORT=6379

WHISPER_WORKER_LOG_LEVEL=debug
WHISPER_WORKER_DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/obsidian_ai
WHISPER_WORKER_REDIS_URL=redis://redis:6379/0
WHISPER_WORKER_QUEUE=audio_transcription_jobs
TRANSCRIPTION_ENGINE=fake
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=5
WHISPER_MODEL_CACHE_DIR=/models/whisper
HF_HOME=/models/whisper
HUGGINGFACE_HUB_CACHE=/models/whisper/hub
